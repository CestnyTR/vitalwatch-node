{
  "name": "vitalwatch-node",
  "version": "0.5.2",
  "description": "VitalWatch Hub için Node.js raporlayıcı — sunucu hataları, SSR hataları, yavaş istekler; Express, Next, Nuxt/Nitro, Fastify, Koa, Hono, NestJS, SvelteKit, React Router",
  "license": "MIT",
  "author": "CestnyTR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CestnyTR/vitalwatch-node.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./express": "./src/express.js",
    "./next": "./src/next.js",
    "./auto": "./src/auto.js",
    "./nuxt": {
      "types": "./types/nuxt.d.ts",
      "default": "./src/nuxt.js"
    },
    "./nitro": {
      "types": "./types/nitro.d.ts",
      "default": "./src/nitro.js"
    }
  },
  "bin": {
    "vitalwatch-status": "bin/vitalwatch-status.js"
  },
  "files": [
    "src",
    "bin",
    "types",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "monitoring",
    "error-tracking",
    "nextjs",
    "express",
    "nuxt",
    "nitro",
    "fastify",
    "koa",
    "hono",
    "nestjs",
    "sveltekit",
    "react-router",
    "vitalwatch"
  ]
}
